---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteNav from '../layouts/SiteNav.astro';
import { siteUrl } from '../../lib/paths.mjs';
---
<SiteLayout title="Page not found · scat" noindex>
  <header class="masthead"><SiteNav /></header>
  <main id="main" tabindex="-1" class="wrap not-found">
    <p class="eyebrow">404 / not found</p>
    <h1>This page does not exist.</h1>
    <p class="lead">The link may be out of date. Start from the home page or browse the documentation.</p>
    <p class="actions">
      <a class="button primary" href={siteUrl()}>Back to home</a>
      <a class="text-link" href={siteUrl('docs/')}>Documentation</a>
    </p>
  </main>
</SiteLayout>
